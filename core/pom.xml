<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.github.yetnt.jaiva</groupId>
        <artifactId>parent</artifactId>
        <version>7.0.0-beta.3</version>
    </parent>

    <artifactId>core</artifactId>

    <properties>
        <maven.compiler.source>25</maven.compiler.source>
        <maven.compiler.target>25</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>

        <!-- For tests -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.9.3</version>
            <scope>test</scope>
        </dependency>

        <!-- My custom common utilities. Such as tuples and more function arities-->

        <dependency>
            <groupId>io.github.yetnt</groupId>
            <artifactId>ytils</artifactId>
            <version>1.4.0</version>
        </dependency>

        <!-- Specifically for loading internal jaiva libraries so we don't have to define it everytime -->

        <dependency>
            <groupId>io.github.classgraph</groupId>
            <artifactId>classgraph</artifactId>
            <version>4.8.180</version>
        </dependency>
        <dependency>
            <groupId>org.jetbrains</groupId>
            <artifactId>annotations</artifactId>
            <version>13.0</version>
            <scope>provided</scope>
        </dependency>

    </dependencies>

    <profiles>
        <profile>
            <id>release-cli</id>
            <build>
                <plugins>

                    <plugin>
                        <artifactId>maven-antrun-plugin</artifactId>
                        <version>3.1.0</version>

                        <executions>
                            <execution>
                                <id>prepare-cli</id>
                                <phase>package</phase>

                                <goals>
                                    <goal>run</goal>
                                </goals>

                                <configuration>
                                    <target>

                                        <delete file="${project.basedir}/jaiva-cli/jaiva.jar"/>
                                        <delete file="${project.basedir}/jaiva-cli/jaiva-sources.jar"/>
                                        <delete file="${project.basedir}/jaiva-cli/jaiva.zip"/>

                                        <copy
                                                file="${project.build.directory}/${project.artifactId}-${project.version}.jar"
                                                tofile="${project.basedir}/jaiva-cli/jaiva.jar"/>

                                        <copy
                                                file="${project.build.directory}/${project.artifactId}-${project.version}-sources.jar"
                                                tofile="${project.basedir}/jaiva-cli/jaiva-sources.jar"/>

                                        <echo file="${project.basedir}/jaiva-cli/version">
                                            ${project.version}
                                        </echo>

                                        <zip
                                                destfile="${project.basedir}/jaiva-cli/jaiva.zip"
                                                basedir="${project.basedir}/jaiva-cli">

                                            <exclude name="jaiva.zip"/>

                                        </zip>

                                    </target>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>

                </plugins>
            </build>
        </profile>
    </profiles>

    <build>

        <plugins>

            <!--
                Creates the actual executable Jaiva JAR.

                This bundles Jaiva's runtime dependencies (currently ytils)
                into the JAR itself.

                It does NOT bundle the Java runtime.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.0</version>

                <executions>
                    <execution>
                        <phase>package</phase>

                        <goals>
                            <goal>shade</goal>
                        </goals>

                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>

                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>com.jaiva.Main</mainClass>
                                </transformer>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>

                <configuration>
                    <source>25</source>
                    <target>25</target>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-source-plugin</artifactId>
                <version>3.3.0</version>

                <executions>
                    <execution>
                        <id>attach-sources</id>

                        <goals>
                            <goal>jar</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <version>3.3.1</version>

                <executions>
                    <execution>
                        <id>copy-icon</id>
                        <phase>process-resources</phase>

                        <goals>
                            <goal>copy-resources</goal>
                        </goals>

                        <configuration>
                            <outputDirectory>${project.build.directory}</outputDirectory>

                            <resources>
                                <resource>
                                    <directory>src/main/resources</directory>

                                    <includes>
                                        <include>jaiva.ico</include>
                                    </includes>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

        </plugins>
    </build>

</project>