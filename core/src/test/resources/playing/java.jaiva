tsea "jaiva/arrays"!
tsea "jaiva/types"!
tsea "jaiva/debug" <- d_getScope!
tsea "jaiva/time/zone"!

@* this fuc should proly go in arrs
kwenza *a_find(arr, F~func) ->
    colonize (element with arr) ->
        sif (func(element) = yebo) ?> khutla element!
    <~
    khutla idk!
<~

@* depr  $> lets see if this deprecation message even shows in the warning cuz it from JDoc from a compeltely different file
kwenza *field(name, prop, accessor?) ->
    khutla arrLit(name, prop, accessor)!
<~

kwenza *method(name, F~callback, accessor?) ->
    khutla arrLit(name, callback, accessor)!
<~

kwenza *getMethods(class) ->
    khutla class[2]!
<~

kwenza *getFields(class) ->
    khutla class[1]!
<~

kwenza *getClassProperties(class, prop?) ->
    maak arr <- class[0]!

    if (prop = "name") ->
        khutla arr[1]!
    <~ mara if (prop = "id") ->
        khutla arr[0]!
    <~
<~

kwenza *get(class, prop) ->
    maak split <- a_from(prop, ".")!

    sif (split[0] != getClassProperties(class, "name")) ?> cima <== "wrong class"!

    maak found <- a_find(getFields(class))!
        |> f~(el) : el[0] = split[1]!

    if (typeOf(found) = "array") ->
        if (found[2] = -1) ->
            cima <== prop + " is inaccessible"!
        <~
        khutla found[1]!
    <~
<~

kwenza *call(class, prop, params) ->
    maak split <- a_from(prop, ".")!

    sif (split[0] != getClassProperties(class, "name")) ?> cima <== "wrong class"!

    maak found <- a_find()!
        |> getMethods(class)!
        |> f~(el) : el[0] = split[1]!

    if (typeOf(found) = "array") ->
        maak d <- found[1]!
        khutla d(class, params:::)!
    <~
<~

kwenza *unsafeCast(class1, convertTo) ->
    khutla arrLit(convertTo[0], class1[1])!
<~

kwenza *newClass(name, fields, methods, accessor?) ->
    tsea "jaiva/time" <- t_now!
    maak more <- arrLit(methods:::)!
        |> method("this", f~(<-i) : i[0])!
    maak props <-| t_now() - 100 << 3, name, accessor!
    khutla arrLit(props, fields, more)!
<~

maak name <- field("name", "i am guy")!
maak id <- field("id", 1001, -1)!

maak getId <- method("getId")!
    |> f~(<-i) : get(i[0], "MyClass.id")!

maak myMethid <- method("add")!
    |> f~(<-i) : i[1] + i[2]!

maak sub <- method("sub")!
    |> f~(<-i) : i[1] - i[2]!

maak MyClass <- newClass("MyClass")!
    |> arrLit(id, name)!
    |> arrLit(myMethid, sub, getId)!

maak OtherClass <- newClass("OtherClass")!
    |> arrLit(id, name)!
    |> arrLit(myMethid, sub, getId)!

khuluma(call(MyClass, "MyClass.getId", arrLit()))!
khuluma(call(MyClass, "MyClass.this", arrLit()))!
khuluma(get(MyClass, "MyClass.id"))!
khuluma(call(MyClass, "MyClass.add", arrLit(100, 200)))!
khuluma()!

mamela()!

