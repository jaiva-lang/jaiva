
@ server.jiv

tsea "jaiva/continuous"!
tsea "jaiva/net"!
tsea "jaiva/threads"!
tsea "./shared"!

kwenza connectionHandler(con, conId, conAddress) ->

    kwenza closedHandler(_, _2, type) ->
        khuluma("Socket was closed suddenly! Next message is more specific")!
        @ we have conId and conAddress already.
        maak identifier <- "$t |> " + conId + " on " +  conAddress!

        @ if i ever introduce a switch, itd naturally replace this.
        sif (type = "CONNECTION") ?> khuluma(identifier + " closed gracefully.")!
        sif (type = "ERR") ?> khuluma(identifier + " crashed suddenly!")!
        sif (type = "INPUT") ?> khuluma(identifier + " closed it's input stream!")!
        sif (type = "OUTPUT") ?> khuluma(identifier + " closed it's output stream!")!


	    con(C_CLOSE)()!
    <~

	con(C_CLOSED)(closedHandler, true)!
		@ Calls the con(C_CLOSE)() for us after our function has ran.

	@ probably make better EOF handling. (by using an actual function and not a lambda to log lol.)
	con(C_EOF)()!
		|> f~(conId2, conAddre) : khuluma(conId2 + " encountered EOF wile reading!")!
		|> true! @ similar to above.

	zama zama ->
	    khuluma("sending packet")!
		sendPacket(con, "What's up bro")!
		khuluma("packet sent")!

		nikhil ((con(C_EOF)()') && (con(C_CLOSED)()')) ->
		    khuluma("Waiting for " + conAddress + " to send us a packet....")!
			khuluma("[RECEIVED:]" + readPacket(con))!
		<~

	<~ chaai ->

		@ client exited due to err
		khuluma(conId + " disconnected weirdly..... " + error)!

	<~

	khuluma("Closing communication with " + conAddress)!

	con(C_CLOSE)()! @ Default implementation will close both streams if no constant input is given.
<~

kwenza server(F~acceptConn, F~close) ->
    khuluma("Started server")!
    zama zama ->
        nikhil (true;) ->
            khuluma("Waiting for a connection...")!
            maak c <- acceptConn()! @ [con, conId, conAddress]
            khuluma("Established connection from " + c[2])!
            thread(f~() : connectionHandler(c[0], c[1], c[2]))!
        <~
	<~ chaai ->
	    khuluma("Server experienced an error")!
	    khuluma(error)!
	    close()! @ close for good measure
	<~
<~

tcp_serve(5050, server)!
