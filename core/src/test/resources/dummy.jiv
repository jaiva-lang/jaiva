@ maak [copy-on-read cor] x <- 10!
@ maak [frozen] r <- 1!
@ kwenza [constant] t(a, b) ->
@     khutla a + b!
@ <~
@
@ khuluma(x, r)!
@
@ t <- khuluma!
@ @
@ maak [mod1, mod2, mod3] c!
@ maak [mod1 mod2 mo3] c! @ Both work, if there is a comma it will use that as the splitter.

@ kwenza func(a) ->
@     [cor] a <- f~() : 6!
@     [cow] a <- f~() : 9!
@     khuluma(a())!      @ 9
@     khuluma(\a())!     @ 6
@     khuluma(\\a())!    @ 10
@ <~
@ func(f~() : 10)!

kwenza funcz(a) ->
    [cor] a <- f~() : 6!
    [cow] a <- aowa!
    khuluma(a)!      @ false
    khuluma(\a())!   @ 6
    khuluma(\\a)!    @ 10
<~
funcz(10)!

@ maak z <- 10!
